{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/multilingual-video-learning/grammar-report.schema.json",
  "title": "grammar-report",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "reportType": { "type": "string", "const": "multilingual-grammar-report" },
    "explanationLanguage": {
      "type": "string",
      "enum": ["zh-CN", "ja-JP", "en"]
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["zh", "zh-Hans", "zh-Hant", "ja", "en", "mixed", "und"]
      }
    },
    "source": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["subtitle", "text", "subtitle-package"]
        },
        "title": {
          "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
        }
      },
      "required": ["type", "title"],
      "additionalProperties": false
    },
    "analysis": {
      "type": "object",
      "properties": {
        "model": { "type": "string", "minLength": 1 },
        "modelConfigurationHash": { "type": "string", "minLength": 1 },
        "analyzerVersion": { "type": "string", "minLength": 1 },
        "generatedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
        }
      },
      "required": [
        "model",
        "modelConfigurationHash",
        "analyzerVersion",
        "generatedAt"
      ],
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "properties": {
        "sentenceCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "grammarPointCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "languageCounts": {
          "type": "object",
          "propertyNames": { "type": "string" },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "levelCounts": {
          "type": "object",
          "propertyNames": { "type": "string" },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        }
      },
      "required": [
        "sentenceCount",
        "grammarPointCount",
        "languageCounts",
        "levelCounts"
      ],
      "additionalProperties": false
    },
    "sentences": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "cueIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "start": {
            "anyOf": [{ "type": "number", "minimum": 0 }, { "type": "null" }]
          },
          "end": {
            "anyOf": [
              { "type": "number", "exclusiveMinimum": 0 },
              { "type": "null" }
            ]
          },
          "language": {
            "type": "string",
            "enum": ["zh", "zh-Hans", "zh-Hant", "ja", "en", "mixed", "und"]
          },
          "languages": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["zh", "zh-Hans", "zh-Hant", "ja", "en", "mixed", "und"]
            }
          },
          "text": { "type": "string", "minLength": 1 },
          "reading": {
            "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
          },
          "translation": {
            "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
          },
          "previousSentenceId": {
            "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
          },
          "nextSentenceId": {
            "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
          },
          "reconstructionConfidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "needsReview": { "type": "boolean" },
          "grammar": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "language": {
                  "type": "string",
                  "enum": [
                    "zh",
                    "zh-Hans",
                    "zh-Hant",
                    "ja",
                    "en",
                    "mixed",
                    "und"
                  ]
                },
                "surface": { "type": "string", "minLength": 1 },
                "pattern": { "type": "string", "minLength": 1 },
                "category": { "type": "string", "minLength": 1 },
                "formation": { "type": "string", "minLength": 1 },
                "meaning": { "type": "string", "minLength": 1 },
                "explanation": { "type": "string", "minLength": 1 },
                "nuance": {
                  "anyOf": [
                    { "type": "string", "minLength": 1 },
                    { "type": "null" }
                  ]
                },
                "context": {
                  "anyOf": [
                    { "type": "string", "minLength": 1 },
                    { "type": "null" }
                  ]
                },
                "examples": {
                  "minItems": 1,
                  "maxItems": 1,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "text": { "type": "string", "minLength": 1 },
                      "reading": {
                        "anyOf": [
                          { "type": "string", "minLength": 1 },
                          { "type": "null" }
                        ]
                      },
                      "translation": {
                        "anyOf": [
                          { "type": "string", "minLength": 1 },
                          { "type": "null" }
                        ]
                      }
                    },
                    "required": ["text", "reading", "translation"],
                    "additionalProperties": false
                  }
                },
                "levelSystem": {
                  "type": "string",
                  "enum": ["JLPT", "HSK", "CEFR", "unknown"]
                },
                "level": { "type": "string", "minLength": 1 },
                "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
              },
              "required": [
                "id",
                "language",
                "surface",
                "pattern",
                "category",
                "formation",
                "meaning",
                "explanation",
                "nuance",
                "context",
                "examples",
                "levelSystem",
                "level",
                "confidence"
              ],
              "additionalProperties": false
            }
          },
          "vocabulary": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "surface": { "type": "string", "minLength": 1 },
                "language": {
                  "type": "string",
                  "enum": [
                    "zh",
                    "zh-Hans",
                    "zh-Hant",
                    "ja",
                    "en",
                    "mixed",
                    "und"
                  ]
                },
                "reading": {
                  "anyOf": [
                    { "type": "string", "minLength": 1 },
                    { "type": "null" }
                  ]
                },
                "meaning": { "type": "string", "minLength": 1 }
              },
              "required": ["surface", "language", "reading", "meaning"],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "cueIds",
          "start",
          "end",
          "language",
          "languages",
          "text",
          "reading",
          "translation",
          "previousSentenceId",
          "nextSentenceId",
          "reconstructionConfidence",
          "needsReview",
          "grammar",
          "vocabulary"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "reportType",
    "explanationLanguage",
    "languages",
    "source",
    "analysis",
    "summary",
    "sentences"
  ],
  "additionalProperties": false
}
